# Copy to .env and fill in. .env is gitignored — never commit real values.
# cp .env.example .env

# --- Server ---
PORT=8080
DATABASE_PATH=./otrango.db

# Public URL where Vapi can reach this service.
# Local dev: your ngrok forwarding URL, e.g. https://abc123.ngrok-free.app
PUBLIC_BASE_URL=

# --- Owner ---
OWNER_USER_ID=owner
# The name given to the counterparty for pickup.
CUSTOMER_NAME=

# The restaurant. Dialed when a mandate doesn't name a number.
TARGET_PHONE_NUMBER=

# The counterparty as a human would name it. Without it a confirmation can only
# say "calling +1415…", which tells the owner nothing about what they are
# authorizing. Blank falls back to "the restaurant".
TARGET_BUSINESS_NAME=

# The owner's standing preferences: places, menus, routing. Blank falls back to
# ./profile.json. A file that exists but does not parse is a hard error, not a
# silent fallback — the built-in menu would dial the wrong place.
PROFILE_PATH=

# --- Vapi ---
# Dashboard -> API Keys. Use the PRIVATE key (server-side).
VAPI_API_KEY=

# Dashboard -> Phone Numbers. UUID of the number placing calls.
VAPI_PHONE_NUMBER_ID=

# From: python cmd/otrango_assistant.py | curl ... (see README)
VAPI_ASSISTANT_ID=

# Shared secret Vapi sends back as the x-vapi-secret header.
# Generate: openssl rand -hex 32
VAPI_WEBHOOK_SECRET=

# --- Telegram (trigger + outcomes) ---
# The owner's channel, in both directions.
#
#   1. Message @BotFather -> /newbot -> copy the token here.
#   2. Open the t.me link it gives you and send the bot anything. A bot cannot
#      start a conversation, so until you do this it has no chat to reply to.
#   3. curl -s "https://api.telegram.org/bot<TOKEN>/getUpdates" \
#        | jq '.result[-1].message.chat.id'
#
# The token is a live credential: anyone holding it can read and send as this
# bot. TELEGRAM_CHAT_ID is the only chat the poller accepts, so it is what
# stops anyone who knows the bot's handle from making this service dial.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# --- LLM ---
# Used by the voice agent and by the T0 eval tier — the same model, so evals
# test what ships.
ANTHROPIC_API_KEY=

# A voice agent lives inside a sub-second turn budget, so the default is the
# fastest capable model rather than the most capable one.
#
# Use a DATED model id. Vapi validates against its own allow-list and rejects
# the undated aliases the Anthropic API accepts; dated ids work with both.
# For more reasoning at the cost of latency: claude-sonnet-5. Vapi does not
# accept opus.
OTRANGO_LLM_MODEL=claude-haiku-4-5-20251001

# --- Voice ---
# Two selectable profiles so an A/B sweep needs no code change. Either may be
# left blank, in which case calls keep whatever voice the Vapi assistant has.
#
# Voice affects turn timing: TTS time-to-first-byte feeds into inter-turn gaps,
# which is what produces the agent-to-agent pathologies (PLAN.md 3.2). Pick on
# latency first, sound second, and hold it constant across an eval sweep.
DEFAULT_VOICE=agent

# The stock provider voice.
VOICE_PROVIDER=11labs
VOICE_ID=
VOICE_MODEL=

# Your cloned voice. Same provider fields; see RESEARCH.md 4.2 for the steps.
MY_VOICE_PROVIDER=11labs
MY_VOICE_ID=
MY_VOICE_MODEL=

# --- Phase 0 only ---
# Your own phone. Used by the bare POST /api/calls dial path.
TEST_PHONE_NUMBER=
